# SDK E2E Test Configuration
# Copy to .env and adjust values for your environment

# API base URL (must be running with test-login enabled)
SDK_E2E_API_URL=http://localhost:3000

# Secret for /auth/test-login endpoint
SDK_E2E_SECRET=e2e-test-secret-do-not-use-in-production

# Throttle bypass secret (must match THROTTLE_BYPASS_SECRET in API .env)
THROTTLE_BYPASS_SECRET=test-throttle-bypass-secret
