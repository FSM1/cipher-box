# Load Test Configuration
# Copy to .env and adjust values for your environment

# Target API URL
LOAD_TEST_API_URL=http://localhost:3000

# Secret for /auth/test-login
LOAD_TEST_SECRET=e2e-test-secret-do-not-use-in-production

# Number of concurrent virtual users (default: 5)
LOAD_TEST_CLIENTS=5

# Test duration in seconds for sustained scenarios (default: 300)
LOAD_TEST_DURATION=300
