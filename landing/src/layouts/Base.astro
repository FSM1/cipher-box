---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CipherBox - Privacy-First Encrypted Cloud Storage',
  description = 'Client-side encrypted cloud storage with decentralized persistence. Zero-knowledge architecture — your keys, your data.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cipherbox.cc" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <div class="page-container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
