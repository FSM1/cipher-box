// ---- operating-rules cheat-sheet ----
const rules = [
  { op: 'Create / upload / restore', ch: 'new node + parent read-body re-seal', rg: 'no (auto-reach)', rot: 'no', ipns: 'new node’s own', cost: 'O(1)' },
  { op: 'Copy', ch: 'decrypt + RE-ENCRYPT under fresh key → new CID (can’t reuse source CID)', rg: 'no (auto-reach)', rot: 'no', ipns: 'new node’s own', cost: 'O(content)' },
  { op: 'Rename (file / folder)', ch: 'name on the EDGE → parent read-body re-seal', rg: 'no', rot: 'no', ipns: 'unchanged', cost: 'O(1)' },
  { op: 'Move within same scope', ch: 're-link both parents (folder = O(1))', rg: 'no', rot: 'no', ipns: 'unchanged', cost: 'O(1)' },
  { op: 'Move INTO a share', ch: 're-link; key now reachable by recipients', rg: 'grant via chain', rot: 'no', ipns: 'unchanged', cost: 'O(1)' },
  { op: 'Move OUT of a share', ch: 're-link + rotate (leaves scope)', rg: 're-mint remaining', rot: 'yes · read', ipns: 'unchanged', cost: 'O(subtree)' },
  { op: 'Move BETWEEN shares', ch: 'rotate (cut A) then link (grant B)', rg: 're-mint + grant', rot: 'yes · read', ipns: 'unchanged', cost: 'O(subtree)' },
  { op: 'Edit / new version', ch: 'content swap; old kept in versions[]', rg: 'no', rot: 'no', ipns: 'unchanged', cost: 'O(1)' },
  { op: 'Delete private → bin', ch: 'unlink + BinEntry', rg: 'no', rot: 'no', ipns: 'unchanged', cost: 'O(1)' },
  { op: 'Delete SHARED → bin', ch: 'unlink + BinEntry + rotate + delete grants (cascades to nested sub-shares)', rg: 'delete subtree grants', rot: 'yes · read', ipns: 'unchanged', cost: 'O(subtree)' },
  { op: 'Rename OVER shared dest', ch: 'rotate victim (revoke) + parent re-seal', rg: 're-mint', rot: 'yes · read', ipns: 'unchanged', cost: 'O(victim)' },
  { op: 'Add recipient / upgrade r→w', ch: 'one grant row (ECIES to recipient)', rg: 'new grant', rot: 'no', ipns: 'unchanged', cost: 'O(1)' },
  { op: 'Revoke read', ch: 'rotate readKey + fileKey of subtree', rg: 're-mint remaining', rot: 'yes · read', ipns: 'unchanged', cost: 'O(items)' },
  { op: 'Revoke write / downgrade', ch: 'Ed25519 cascade + parent re-point', rg: 'update grants', rot: 'yes · write', ipns: 'CHANGES (new k51)', cost: 'O(subtree)' },
  { op: 'Write-recipient adds in share', ch: 'new node sealed into BOTH chains', rg: 'no (auto-reach)', rot: 'no', ipns: 'new node’s own', cost: 'O(1)' },
];
---

<Base
  title="CipherBox — The Node Model (Explainer)"
  description="How encrypted folder/file metadata, key-chaining, sharing, and revocation work in the proposed CipherBox Node model."
>
  <!-- Intro -->
  <section class="section intro">
    <p class="kicker">{'// proposed design — approach (c) — not yet shipped'}</p>
    <h1 class="intro-title">The Node Model</h1>
    <p class="intro-lede">
      One <strong>Node</strong> type for folders, files, and the vault root. Read access flows
      down a <strong>key chain</strong> sealed into the metadata itself — so sharing a subtree is
      <em>one</em> wrapped key, not a per-item table. Write access is a separate chain of Ed25519
      signing keys. The server stays a zero-knowledge relay throughout.
    </p>
    <div class="planes">
      <div class="plane card">
        <h3 class="plane-h">{'> read plane'}</h3>
        <p>Metadata key-chaining. Revocation = rotate the subtree (expensive, O(items)).</p>
      </div>
      <div class="plane card">
        <h3 class="plane-h">{'> write plane'}</h3>
        <p>Ed25519 signing keys. Revocation = rotate the keypairs / re-point parents.</p>
      </div>
    </div>
  </section>

  <!-- Anatomy -->
  <section class="section">
    <h2 class="section-title">Anatomy of a Node</h2>
    <p class="section-desc">
      What the client holds (decrypted) vs. what IPFS and the relay store (sealed). The relay only
      ever sees the right-hand object.
    </p>
    <div class="anatomy-grid">
      <div>
        <div class="meta-label">decrypted — client only</div>
        <div class="meta">{anatomy.decrypted.map((l) => <div class={`ln ${l.k}`}>{l.t || ' '}</div>)}</div>
      </div>
      <div>
        <div class="meta-label">published — relay / IPFS see this</div>
        <div class="meta">{anatomy.published.map((l) => <div class={`ln ${l.k}`}>{l.t || ' '}</div>)}</div>
      </div>
    </div>
    <div class="meta-label" style="margin-top: var(--spacing-lg)">the chain link</div>
    <div class="meta">{anatomy.childref.map((l) => <div class={`ln ${l.k}`}>{l.t || ' '}</div>)}</div>

    <div class="secrets">
      {secrets.map((s) => (
        <div class="secret">
          <span class="secret-k">{s.k}</span>
          <span class="secret-t">{s.t}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Rules -->
  <section class="section">
    <h2 class="section-title">Operating rules</h2>
    <p class="section-desc">
      The whole model reduces to a handful of rules. Only operations that make a node LEAVE a
      recipient’s scope trigger a key rotation; everything else is a parent re-seal or a single
      grant row. k51 names change only on write-revocation.
    </p>
    <div class="rules-wrap">
      <table class="rules-table">
        <thead>
          <tr><th>operation</th><th>what changes</th><th>re-grant?</th><th>rotation?</th><th>ipnsName</th><th>cost</th></tr>
        </thead>
        <tbody>
          {rules.map((r) => (
            <tr>
              <td class="r-op">{r.op}</td>
              <td>{r.ch}</td>
              <td>{r.rg}</td>
              <td class={r.rot.startsWith('yes') ? 'r-rot' : 'r-no'}>{r.rot}</td>
              <td class={r.ipns.startsWith('CHANGES') ? 'r-rot' : ''}>{r.ipns}</td>
              <td class="r-cost">{r.cost}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Flows -->
  <section class="section">
    <h2 class="section-title">Transforms</h2>
    <p class="section-desc">
      Each operation as a before → after on the affected metadata, with the per-layer steps.
      Highlighted lines are what changed.
    </p>

    {numberedGroups.map((g) => (
      <div class="flow-group">
        <h3 class="group-title">{g.title}</h3>
        <p class="group-desc">{g.desc}</p>
        <div class="flows">
          {g.flows.map((f) => (
        <article class="flow" id={f.id}>
          <header class="flow-head">
            <span class="flow-n">{f.n}</span>
            <h3 class="flow-title">{f.title}</h3>
            <span class="flow-tag">{f.tag}</span>
          </header>
          <p class="flow-desc">{f.desc}</p>

          <div class="panels">
            <div class="panel">
              <div class="meta-label">{f.before.label}</div>
              <div class="meta">{f.before.lines.map((l) => <div class={`ln ${l.k}`}>{l.t || ' '}</div>)}</div>
            </div>
            <div class="panel-arrow" aria-hidden="true">{'→'}</div>
            <div class="panel">
              <div class="meta-label">{f.after.label}</div>
              <div class="meta">{f.after.lines.map((l) => <div class={`ln ${l.k}`}>{l.t || ' '}</div>)}</div>
            </div>
          </div>

          <ol class="flow-legend steps">
            {f.steps.map((s, i) => (
              <li class="legend-item">
                <span class="legend-step">{String(i + 1).padStart(2, '0')}</span>
                <span class="legend-label">{s}</span>
              </li>
            ))}
          </ol>
        </article>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Asymmetry summary -->
  <section class="section">
    <h2 class="section-title">The revocation asymmetry</h2>
    <div class="asym-grid">
      <div class="card asym">
        <h3 class="asym-h">{'> read-revoke'}</h3>
        <p>Rotate readKey + fileKey of every node in scope. k51 names unchanged; TEE untouched.
          <strong>O(items)</strong> republishes. Already-fetched content is irreducibly readable (it’s on IPFS).</p>
      </div>
      <div class="card asym">
        <h3 class="asym-h">{'> write-revoke (c)'}</h3>
        <p>Rotate Ed25519 keypairs → new k51 names → parent re-point cascade + TEE re-enroll + grant
          updates. <strong>O(subtree)</strong>, and heavier per node than read-revoke. The cheap
          O(1) version only exists under approach (a) mediated writes.</p>
      </div>
    </div>
    <p class="foot"><a href="/">{'← back'}</a></p>
  </section>
</Base>

<style>
  .intro {
    padding-bottom: var(--spacing-2xl);
  }
  .kicker {
    color: var(--color-text-dim);
    font-size: var(--font-size-sm);
    margin-bottom: var(--spacing-md);
  }
  .intro-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    text-shadow: var(--glow-green);
    margin-bottom: var(--spacing-lg);
  }
  .intro-lede {
    max-width: 760px;
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
    line-height: 1.7;
  }
  .intro-lede strong { color: var(--color-green-primary); }
  .intro-lede em { color: var(--color-text-primary); font-style: normal; text-decoration: underline; }

  .planes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-xl);
  }
  .plane-h { font-size: var(--font-size-md); margin-bottom: var(--spacing-xs); }
  .plane p { color: var(--color-text-muted); font-size: var(--font-size-sm); }

  /* ---- metadata panels ---- */
  .meta-label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xs);
  }
  .meta {
    border: 1px solid var(--color-border-dim);
    background: rgb(0 0 0 / 60%);
    padding: var(--spacing-md);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    line-height: 1.55;
    overflow-x: auto;
  }
  .ln {
    white-space: pre;
    color: var(--color-text-muted);
    display: block;
  }
  .ln.cmt { color: var(--color-text-dim); }
  .ln.add {
    color: var(--color-green-primary);
    background: rgb(0 208 132 / 8%);
    border-left: 2px solid var(--color-green-primary);
    padding-left: 6px;
    margin-left: -8px;
  }
  .ln.mod {
    color: var(--color-green-primary);
    border-left: 2px dashed var(--color-green-dim);
    padding-left: 6px;
    margin-left: -8px;
  }
  .ln.del {
    color: var(--color-text-dim);
    text-decoration: line-through;
    opacity: 0.7;
  }

  .anatomy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
  }

  .secrets {
    margin-top: var(--spacing-xl);
    display: grid;
    gap: var(--spacing-sm);
  }
  .secret {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--spacing-md);
    align-items: baseline;
    border-left: 1px solid var(--color-border-dim);
    padding-left: var(--spacing-md);
  }
  .secret-k {
    color: var(--color-green-primary);
    font-weight: var(--font-weight-bold);
  }
  .secret-t { color: var(--color-text-muted); font-size: var(--font-size-sm); }

  /* ---- groups + rules ---- */
  .flow-group { margin-bottom: var(--spacing-4xl); }
  .group-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-green-primary);
    border-bottom: 1px solid var(--color-border-dim);
    padding-bottom: var(--spacing-xs);
    margin-bottom: var(--spacing-xs);
  }
  .group-title::before { content: ">> "; color: var(--color-text-secondary); }
  .group-desc {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin-bottom: var(--spacing-xl);
    max-width: 820px;
  }

  .rules-wrap { overflow-x: auto; border: 1px solid var(--color-border-dim); }
  .rules-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
    min-width: 880px;
  }
  .rules-table th {
    text-align: left;
    text-transform: uppercase;
    font-size: var(--font-size-xs);
    letter-spacing: 0.06em;
    color: var(--color-black);
    background: var(--color-green-dim);
    padding: var(--spacing-xs) var(--spacing-sm);
  }
  .rules-table td {
    padding: var(--spacing-xs) var(--spacing-sm);
    border-top: 1px solid var(--color-border-dim);
    color: var(--color-text-muted);
    vertical-align: top;
  }
  .rules-table .r-op { color: var(--color-green-primary); font-weight: var(--font-weight-semibold); white-space: nowrap; }
  .rules-table .r-rot { color: var(--color-green-primary); }
  .rules-table .r-no { color: var(--color-text-dim); }
  .rules-table .r-cost { color: var(--color-text-secondary); white-space: nowrap; }

  /* ---- flows ---- */
  .flows { display: flex; flex-direction: column; gap: var(--spacing-3xl); }
  .flow { border-top: 1px solid var(--color-border-dim); padding-top: var(--spacing-xl); }
  .flow-head {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xs);
    flex-wrap: wrap;
  }
  .flow-n {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-green-primary);
    text-shadow: var(--glow-green);
  }
  .flow-title { font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); }
  .flow-tag {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-black);
    background: var(--color-green-dim);
    padding: 2px 8px;
  }
  .flow-desc {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    max-width: 820px;
    margin-bottom: var(--spacing-lg);
  }

  .panels {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--spacing-md);
    align-items: stretch;
    margin-bottom: var(--spacing-lg);
  }
  .panel { min-width: 0; }
  .panel-arrow {
    align-self: center;
    color: var(--color-green-primary);
    font-size: var(--font-size-xl);
    text-shadow: var(--glow-green);
  }

  .steps { margin-top: var(--spacing-md); }

  /* ---- asymmetry ---- */
  .asym-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-lg); }
  .asym-h { font-size: var(--font-size-md); margin-bottom: var(--spacing-xs); }
  .asym p { color: var(--color-text-muted); font-size: var(--font-size-sm); }
  .asym strong { color: var(--color-green-primary); }
  .foot { margin-top: var(--spacing-2xl); }

  @media (max-width: 768px) {
    .planes, .anatomy-grid, .asym-grid { grid-template-columns: 1fr; }
    .secret { grid-template-columns: 1fr; gap: 2px; }
    .panels { grid-template-columns: 1fr; }
    .panel-arrow { transform: rotate(90deg); justify-self: center; }
    .intro-title { font-size: var(--font-size-2xl); }
  }
</style>
