---
import Base from '../layouts/Base.astro';

// ===========================================================================
// Concrete (illustrative) values — short, realistic-looking, static.
// These mirror real CipherBox formats; hex is truncated for readability.
// ===========================================================================

const V = {
  userPub: '04a91f…c0d1',
  rootRead: '9f8e7d6c…2a3b4c5d',
  rootWrite: '7a1c0b2d…11ee22ff',
  rootIpns: 'k51qzi5…vnlkd5e',
  faId: '550e8400…0000',
  faRead: '1a2b3c4d…d6e7f809',
  faReadV2: 'c4d5e6f7…0a1b2c3d', // after read-revoke rotation
  faWrite: '3c4d5e6f…aa00bb11',
  faWriteV2: 'b8c7d6e5…44556677', // after write-revoke rotation
  faIpns: 'k51qzi5…46bze3',
  faIpnsV2: 'k51qzi5…NEW9f2c', // after Ed25519 rotation (write-revoke)
  f3Id: '7c9e6679…0ae7',
  f3Read: '8e7d6c5b…f0a9b8c7',
  f3ReadV2: 'a0b1c2d3…e4f5a6b7',
  f3File: 'deadbeef…0123456',
  f3FileV2: 'feedface…7654321',
  f3Ipns: 'k51qzi5…82jwe9',
  f3IpnsV2: 'k51qzi5…NEWab27',
  contentCid: 'bafy…content1',
  contentCidV2: 'bafy…content2',
  f3MetaCid: 'bafy…f3meta1',
  bPub: '04b2c3…f3a4',
  cPub: '04c3d4…a4b5',
  eciesB: '04e3a1b2…b6c7',
  eciesCr: '04f4b5c6…a4b5',
  eciesCw: '04d2e3f4…c1d2',

  // file3 content CID aliases used by the expansion flows
  f3Cid: 'bafy…f3c0a', f3CidV2: 'bafy…f3c1b',
  // file1 / file2 (in Folder A)
  f1Id: '1f1a0001', f1Read: '11aa22bb…f1f1', f1ReadV2: '55cc66dd…f1f2',
  f1File: 'f11edead…0001', f1FileV2: 'f11ebeef…0002', f1Cid: 'bafy…f1c0a', f1Ipns: 'k51qzi5…f1aa01',
  f2Id: '2f2b0002', f2Read: '22bb33cc…f2f2', f2File: 'f22edead…0003', f2Cid: 'bafy…f2c0b', f2Ipns: 'k51qzi5…f2bb02',
  // subfolder Sub (inside Folder A)
  subId: '5ab0sub0', subRead: '5b1c2d3e…suba', subReadV2: '9f0a1b2c…subb', subIpns: 'k51qzi5…sub017',
  // Folder P (private) + fileX
  fpId: 'fp000009', fpRead: 'fa11fb22…fp00', fpIpns: 'k51qzi5…fp0a09',
  fxId: 'fx00000a', fxRead: 'cd11ef22…fx00', fxReadV2: 'ab33cd44…fx01',
  fxFile: 'fx1edead…000b', fxFileV2: 'fx1ebeef…000c', fxCid: 'bafy…fxc0d', fxIpns: 'k51qzi5…fx0b0a',
  // Folder S2 (shared with D) + file9
  fs2Id: 's200000d', fs2Read: 'e1d2c3b4…s200', fs2Ipns: 'k51qzi5…s2d00d',
  f9Id: 'f900000e', f9Read: '99aa88bb…f900', f9File: 'f91edead…000f', f9Cid: 'bafy…f9c0e', f9Ipns: 'k51qzi5…f90e0e',
  // a copied / write-recipient-created file node
  cpId: 'cp000010', cpRead: 'c0d1e2f3…cp00', cpFile: 'cp1edead…0011', cpCid: 'bafy…cpc01', cpIpns: 'k51qzi5…cp1010',
  // extra recipients + grants
  dPub: '04d4e5…b5c6', ePub: '04e5f6…c6d7',
  eciesD: '04a1d2d3…d4e5', eciesE: '04b2e3e4…e5f6',
  eciesB2: '04c3f4f5…f6a7', eciesCr2: '04d4a5a6…a7b8',
  binIpns: 'k51qzi5…bin099',
};

// helper: a line {t: text, k: kind}  kind ∈ '', 'add', 'mod', 'del', 'cmt'
const L = (t = '', k = '') => ({ t, k });

// ===========================================================================
// Flows
// ===========================================================================

const anatomy = {
  decrypted: [
    L('Node  // decrypted, in client memory only', 'cmt'),
    L('{'),
    L('  schema: "node/v3",'),
    L('  kind: "folder",'),
    L(`  id: "${V.faId}",`),
    L('  generation: 0,            // read-key epoch', 'cmt'),
    L(''),
    L('  // read-body  — sealed under readKey', 'cmt'),
    L('  children: [ SealedChildRef, … ],'),
    L(''),
    L('  // write-body — sealed under a SEPARATE writeKey', 'cmt'),
    L('  write: { ed25519PrivateKey, childLinks[] }'),
    L('}'),
  ],
  published: [
    L('PublishedNode  // on IPFS at a CID; the relay sees ONLY this', 'cmt'),
    L('{'),
    L('  schema: "node/v3",'),
    L('  kind: "folder",          // plaintext — AAD input', 'cmt'),
    L(`  id: "${V.faId}",       // plaintext — AAD input`, 'cmt'),
    L('  generation: 0,           // plaintext — AAD input', 'cmt'),
    L('  aeadVersion: 1,'),
    L('  readSealed:  "b3a9…9f1c"   AES-256-GCM(read-body,  readKey)'),
    L('  writeSealed: "a1c4…cc02"   AES-256-GCM(write-body, writeKey)'),
    L('}'),
  ],
  childref: [
    L('SealedChildRef  // lives INSIDE the parent read-body', 'cmt'),
    L('{'),
    L(`  childId: "${V.faId}", kind: "folder", name: "Folder A",`),
    L(`  ipnsName: "${V.faIpns}",`),
    L('  generation: 0,           // mirror of child; convergence witness', 'cmt'),
    L('  readKeySealed:'),
    L('    AES-GCM( child.readKey, PARENT.readKey,'),
    L('            aad = "…|childId|folder|0|child-readkey" )'),
    L('}'),
  ],
};

const secrets = [
  { k: 'readKey', t: '32B AES. Seals the read-body (children / file content). Chained: a parent ref seals each child.readKey under the parent.readKey. Hold a node’s readKey ⇒ unwrap the whole subtree with symmetric AES.' },
  { k: 'writeKey', t: '32B AES. Seals the write-body (the Ed25519 signing key + write-chain links). A read-only grant never ships this — so the write-body is unreachable.' },
  { k: 'ed25519', t: 'The IPNS identity: ipnsName = deriveIpnsName(pub). Signs the IPNS record that points the name at the latest CID.' },
  { k: 'generation', t: 'Per-node u32. Bumps ONLY on a read-key rotation (revocation). It is the AAD epoch + the rotation convergence witness — distinct from the IPNS sequenceNumber, which bumps on every publish.' },
];

const foundationsFlows = [
  {
    n: '01', id: 'init', title: 'A initializes a vault', tag: 'genesis',
    desc: 'The root Node is born. Nothing exists server-side until A publishes it.',
    before: { label: 'before', lines: [ L('(no vault)', 'cmt') ] },
    after: {
      label: 'after — root Node', lines: [
        L('{', ),
        L('  kind: "root",', 'add'),
        L('  generation: 0,', 'add'),
        L('  children: [],            // empty', 'add'),
        L(`  ipnsName: "${V.rootIpns}",`, 'add'),
        L('  ed25519: derived(userPrivateKey)  // recoverable', 'add'),
        L('}'),
        L(''),
        L('DB  vaults{ owner, rootIpnsName }', 'cmt'),
        L('DB  folder_ipns{ rootIpnsName, seq:1, isRoot:true }', 'cmt'),
        L('TEE enrolled to republish rootIpnsName every 6h', 'cmt'),
      ],
    },
    steps: [
      'generate rootReadKey + rootWriteKey (random 32B); derive root ed25519 → rootIpnsName',
      'recovery blob = ECIES(rootReadKey → userPub) + ECIES(rootWriteKey → userPub)',
      'seal root bodies → upload envelope → sign IPNS record (seq 1)',
      'POST /ipns/publish (+ encryptedIpnsPrivateKey for TEE) → POST /vault/init',
    ],
  },
  {
    n: '02', id: 'mkdir', title: 'A creates "Folder A" in root', tag: 'add child',
    desc: 'A new folder Node is created and linked into root. Root’s generation does NOT change — an add is not a rotation.',
    before: {
      label: 'before — root.children', lines: [
        L('children: []'),
      ],
    },
    after: {
      label: 'after — root.children', lines: [
        L('children: ['),
        L('  SealedChildRef {', 'add'),
        L(`    childId: "${V.faId}", kind:"folder", name:"Folder A",`, 'add'),
        L(`    ipnsName: "${V.faIpns}", generation: 0,`, 'add'),
        L('    readKeySealed: AES-GCM(fa.readKey, ROOT.readKey, aad)', 'add'),
        L('  }', 'add'),
        L(']'),
        L(''),
        L('+ new Folder A Node { generation:0, children:[],', 'cmt'),
        L('    write: { ed25519: fa.ed25519.priv } }', 'cmt'),
        L('root.generation: 0  // unchanged', 'mod'),
      ],
    },
    steps: [
      'generate fa.readKey / fa.writeKey / fa.ed25519 → fa.ipnsName',
      'seal Folder A bodies → upload → publish (seq 1, TEE-enroll fa)',
      'build SealedChildRef, re-seal root read-body under the SAME rootReadKey',
      'publish Folder A then root (seq 2, CAS expected:1)',
    ],
  },
  {
    n: '03', id: 'upload', title: 'A uploads a file into Folder A', tag: 'add child',
    desc: 'Content is encrypted under a per-file fileKey, which lives INSIDE the file node’s own read-body — this is what makes a single file shareable on its own.',
    before: {
      label: 'before — Folder A read-body', lines: [
        L('children: []'),
      ],
    },
    after: {
      label: 'after — new file Node + link', lines: [
        L('file Node {', 'add'),
        L(`  kind:"file", id:"${V.f3Id}", generation:0,`, 'add'),
        L('  content: {                  // sealed under file.readKey', 'add'),
        L(`    cid: "${V.contentCid}",`, 'add'),
        L(`    fileIv: "0a1b…0e1f", fileKey: "${V.f3File}",`, 'add'),
        L('    size: 184, mimeType: "text/plain", versions: []', 'add'),
        L('  } }', 'add'),
        L(''),
        L('Folder A.children += SealedChildRef → file', 'mod'),
        L('Folder A.generation: 0  // unchanged; root untouched', 'cmt'),
      ],
    },
    steps: [
      'fileKey = random 32B; ciphertext = AES-GCM(plaintext, fileKey, iv)',
      'POST /ipfs/upload ciphertext → contentCid (pinned)',
      'seal file content under file.readKey; link into Folder A (readKeySealed under fa.readKey)',
      'publish file (seq 1, TEE-enroll) then Folder A (seq 2). Root is NOT touched.',
    ],
  },
  {
    n: '04', id: 'share-r', title: 'A shares Folder A with B (read-only)', tag: 'one ECIES',
    desc: 'The payoff: ONE wrapped key, one DB row, zero republishes. No share_keys fan-out. B chains the whole subtree from this single key.',
    before: { label: 'before — shares', lines: [ L('[]') ] },
    after: {
      label: 'after — one grant row', lines: [
        L('shares += {', 'add'),
        L('  recipientPublicKey: B,', 'add'),
        L(`  rootNodeId: "${V.faId}",`, 'add'),
        L(`  rootIpnsName: "${V.faIpns}",`, 'add'),
        L('  permission: "read",', 'add'),
        L('  rootGeneration: 0,', 'add'),
        L(`  readKeyEcies: "${V.eciesB}",  // ECIES(fa.readKey → B_pub)`, 'add'),
        L('  writeDescriptorRef: null', 'add'),
        L('}'),
        L(''),
        L('No IPFS / IPNS / TEE change. No node re-sealed.', 'cmt'),
      ],
    },
    steps: [
      'readKeyEcies = wrapKey(fa.readKey, B_pub)   // the single grant',
      'POST /shares { recipient:B, rootNodeId, permission:"read", readKeyEcies }',
      'B later: unwrapKey(readKeyEcies, B_priv) → fa.readKey → chain down (symmetric AES)',
      'B never receives any writeKey, write-body, or ed25519 key.',
    ],
  },
  {
    n: '05', id: 'share-rw', title: 'A shares Folder A with C (read/write)', tag: 'one ECIES + write',
    desc: 'Same read grant as B, plus the write-chain root. Under approach (c), C now holds the Ed25519 signing keys for the subtree.',
    before: { label: 'before — C grant', lines: [ L('(none)', 'cmt') ] },
    after: {
      label: 'after — read + write grant', lines: [
        L('shares += {', 'add'),
        L('  recipientPublicKey: C,', 'add'),
        L(`  rootNodeId: "${V.faId}", rootIpnsName: "${V.faIpns}",`, 'add'),
        L('  permission: "write",', 'mod'),
        L(`  readKeyEcies:  "${V.eciesCr}",  // ECIES(fa.readKey  → C_pub)`, 'add'),
        L(`  writeDescriptorRef: "${V.eciesCw}"  // ECIES(fa.writeKey → C_pub)`, 'add'),
        L('}'),
        L(''),
        L('fa.writeKey unlocks the write-body → ed25519 keys', 'cmt'),
        L('for Folder A + every file (the write chain).', 'cmt'),
      ],
    },
    steps: [
      'readKeyEcies  = wrapKey(fa.readKey,  C_pub)',
      'writeKeyEcies = wrapKey(fa.writeKey, C_pub)   // root of the write chain',
      'POST /shares { recipient:C, permission:"write", readKeyEcies, writeDescriptorRef }',
      '(c) consequence: revoking C’s write later means ROTATING those ed25519 keys.',
    ],
  },
  {
    n: '06', id: 'edit', title: 'C edits the file’s contents', tag: 'content swap',
    desc: 'Only the file node’s content changes. Its readKey and generation stay the same, so Folder A’s SealedChildRef stays valid — the parent is NOT touched.',
    before: {
      label: 'before — file content', lines: [
        L(`cid: "${V.contentCid}",`),
        L(`fileKey: "${V.f3File}",`),
        L('versions: []'),
        L('generation: 0'),
      ],
    },
    after: {
      label: 'after — new version', lines: [
        L(`cid: "${V.contentCidV2}",`, 'mod'),
        L(`fileKey: "${V.f3FileV2}",  // fresh key + IV per version`, 'mod'),
        L(`versions: [ { cid:"${V.contentCid}", … } ]  // old retained`, 'add'),
        L('generation: 0   // UNCHANGED — an edit, not a revoke', 'cmt'),
        L(''),
        L(`file IPNS record: seq 1 → 2  (signed by C)`, 'mod'),
        L('Folder A: untouched. Root: untouched.', 'cmt'),
      ],
    },
    steps: [
      'C chains: fa.writeKey → file.writeKey → file.ed25519.priv (the signer)',
      'encrypt new content under a fresh fileKey → POST /ipfs/upload → newContentCid',
      're-seal file read-body (same file.readKey) → publish file IPNS (seq 2, C signs)',
      'relay accepts by key-possession; sequence gate 1→2 passes. No parent update.',
    ],
  },
  {
    n: '07', id: 'revoke-r', title: 'A revokes B’s read access', tag: 'rotation walk',
    desc: 'The expensive, irreducible side. Rotate readKey (and each fileKey) of every node in scope. k51 names stay the SAME. Scope-root first, so B is cut at the entry point immediately.',
    before: {
      label: 'before — Folder A + grants', lines: [
        L(`Folder A: generation 0, readKey ${V.faRead}`),
        L('shares: [ B(read), C(read) ]'),
      ],
    },
    after: {
      label: 'after — rotated', lines: [
        L('Folder A.generation: 0 → 1', 'mod'),
        L(`Folder A.readKey:  → ${V.faReadV2}`, 'mod'),
        L('each file: readKey rotated; fileKey rotated', 'mod'),
        L('  (contentRekeyPending — next write re-encrypts)  // CRIT-1', 'cmt'),
        L(`ipnsName: ${V.faIpns}   // UNCHANGED`, 'cmt'),
        L(''),
        L('shares: [ C(read) ]', 'mod'),
        L('  B grant: DELETED', 'del'),
        L('  C.readKeyEcies: re-minted vs new fa.readKey; rootGeneration 0→1', 'add'),
      ],
    },
    steps: [
      'root step: rotate fa.readKey, re-seal Folder A, rewrite root’s child-ref, DELETE B, re-mint C',
      'B now fails to unseal Folder A (M1: client also rejects a generation downgrade)',
      'walk down: rotate each file readKey + fileKey; re-seal parent links; publish (seq+1)',
      'resumable + idempotent: verifySubtreeClean = no parent/child generation mismatch. Cost O(items).',
    ],
  },
  {
    n: '08', id: 'revoke-w', title: 'A revokes C’s write access', tag: 'ed25519 cascade',
    desc: 'Approach (c): C cached the signing keys, so deleting the grant is inert. You must ROTATE the Ed25519 keypairs — which changes the k51 names and cascades a parent re-point up to root.',
    before: {
      label: 'before — Folder A node', lines: [
        L(`ipnsName: "${V.faIpns}"`),
        L(`write: { ed25519: <C holds this> }`),
        L(`root.childRef.ipnsName: "${V.faIpns}"`),
      ],
    },
    after: {
      label: 'after — rotated identity', lines: [
        L(`ipnsName: "${V.faIpns}" → "${V.faIpnsV2}"`, 'mod'),
        L(`write: { ed25519: NEW }   writeKey → ${V.faWriteV2}`, 'mod'),
        L(`root.childRef.ipnsName → "${V.faIpnsV2}"   // parent re-point`, 'mod'),
        L('(same for every file: new k51, parent re-point)', 'cmt'),
        L(''),
        L('readKey / fileKey / content: UNCHANGED (C keeps read)', 'cmt'),
        L('TEE: enroll new names, UNENROLL old (old names go dark)', 'mod'),
        L('grants: C → permission "read", writeDescriptorRef null;', 'mod'),
        L('        B + C rootIpnsName updated to new k51', 'mod'),
      ],
    },
    steps: [
      'per node: new ed25519 → new ipnsName; new writeKey; re-seal write-body',
      'parent-pointer cascade leaves→root: every SealedChildRef.ipnsName updated, parent read-body re-sealed',
      'publish under new names (seq 1, TEE-enroll); POST /ipns/unenroll the old names',
      'C’s cached keys now sign abandoned names. Cost O(subtree) + cascade — NOT cheap under (c).',
    ],
  },
];

// ---- expansion groups (filled from the explainer-flow-expansion workflow) ----
const coreFlows = [
{
    id: 'mkdir-sub',
    title: 'Create subfolder "Sub" inside Folder A',
    tag: 'add child',
    desc: 'A new folder Node is linked into Folder A under the SAME faRead. NO rotation and NO re-grant — read recipient B and write recipient C both auto-reach Sub by chaining from faRead.',
    before: {
      label: 'before — Folder A.children',
      lines: [
        L(`children: [`),
        L(`  SealedChildRef { childId:"${V.f1Id}", kind:"file", name:"file1" }`, 'cmt'),
        L(`  SealedChildRef { childId:"${V.f2Id}", kind:"file", name:"file2" }`, 'cmt'),
        L(`]`),
        L(`fa.generation: 0`, 'cmt'),
      ],
    },
    after: {
      label: 'after — Folder A.children',
      lines: [
        L(`children: [`),
        L(`  SealedChildRef { childId:"${V.f1Id}", kind:"file", name:"file1" }`, 'cmt'),
        L(`  SealedChildRef { childId:"${V.f2Id}", kind:"file", name:"file2" }`, 'cmt'),
        L(`  SealedChildRef {`, 'add'),
        L(`    childId: "${V.subId}", kind:"folder", name:"Sub",`, 'add'),
        L(`    ipnsName: "${V.subIpns}", generation: 0,`, 'add'),
        L(`    readKeySealed: AES-GCM(sub.readKey, fa.readKey, aad="...|${V.subId}|folder|0|child-readkey")`, 'add'),
        L(`  }`, 'add'),
        L(`]`),
        L(`fa.generation: 0  // unchanged — add is not a rotation`, 'mod'),
      ],
    },
    steps: [
      'client: mint sub.readKey / sub.writeKey / sub.ed25519 -> subIpns; seal Sub bodies',
      'IPFS/IPNS: upload Sub, publish (seq 1, TEE-enroll subIpns)',
      'client: build SealedChildRef(sub.readKey under faRead, sub.writeKey under faWrite), re-seal Folder A read+write bodies under the SAME faRead/faWrite',
      'IPNS/relay: publish Folder A (seq++, CAS gate); B & C auto-reach Sub via faRead chain — NO re-grant, O(1)',
    ],
  },
  {
    id: 'rename-file1',
    title: 'Rename file1 to "report-final.txt"',
    tag: 'rename',
    desc: 'The name lives on the EDGE (parent SealedChildRef), so rename re-seals ONLY Folder A read-body under the SAME faRead. The file node, f1Read and f1Ipns are untouched; generation unchanged.',
    before: {
      label: 'before — Folder A.children[file1]',
      lines: [
        L(`SealedChildRef {`),
        L(`  childId: "${V.f1Id}", kind:"file",`),
        L(`  name: "file1",`, 'mod'),
        L(`  ipnsName: "${V.f1Ipns}", generation: 0,`, 'cmt'),
        L(`  readKeySealed: AES-GCM(f1.readKey, fa.readKey, aad)`, 'cmt'),
        L(`}`),
      ],
    },
    after: {
      label: 'after — Folder A.children[file1]',
      lines: [
        L(`SealedChildRef {`),
        L(`  childId: "${V.f1Id}", kind:"file",`),
        L(`  name: "report-final.txt",`, 'mod'),
        L(`  ipnsName: "${V.f1Ipns}", generation: 0,  // node UNTOUCHED`, 'cmt'),
        L(`  readKeySealed: AES-GCM(f1.readKey, fa.readKey, aad)  // unchanged`, 'cmt'),
        L(`}`),
      ],
    },
    steps: [
      'client: change name field in Folder A SealedChildRef for f1Id only',
      'client: re-seal Folder A read-body under the SAME faRead (no key change)',
      'IPNS/relay: publish Folder A (seq++, CAS gate) — O(1)',
      'note: f1Ipns + file1 node never republished; readers see the new name by chaining faRead',
    ],
  },
  {
    id: 'rename-sub',
    title: 'Rename subfolder Sub to "Archive"',
    tag: 'rename',
    desc: 'Same edge-rename: only Folder A read-body is re-sealed under faRead. Sub node, subRead, subIpns and its entire subtree (file3) are untouched; generation unchanged.',
    before: {
      label: 'before — Folder A.children[Sub]',
      lines: [
        L(`SealedChildRef {`),
        L(`  childId: "${V.subId}", kind:"folder",`),
        L(`  name: "Sub",`, 'mod'),
        L(`  ipnsName: "${V.subIpns}", generation: 0,`, 'cmt'),
        L(`  readKeySealed: AES-GCM(sub.readKey, fa.readKey, aad)`, 'cmt'),
        L(`}`),
      ],
    },
    after: {
      label: 'after — Folder A.children[Sub]',
      lines: [
        L(`SealedChildRef {`),
        L(`  childId: "${V.subId}", kind:"folder",`),
        L(`  name: "Archive",`, 'mod'),
        L(`  ipnsName: "${V.subIpns}", generation: 0,  // node + subtree UNTOUCHED`, 'cmt'),
        L(`  readKeySealed: AES-GCM(sub.readKey, fa.readKey, aad)  // unchanged`, 'cmt'),
        L(`}`),
      ],
    },
    steps: [
      'client: change name field in Folder A SealedChildRef for subId only',
      'client: re-seal Folder A read-body under the SAME faRead',
      'IPNS/relay: publish Folder A (seq++, CAS gate) — O(1)',
      'note: subIpns + file3 never republished; the subtree stays sealed under subRead',
    ],
  },
  {
    id: 'copy-file2',
    title: 'Copy file2 to "file2 (copy)"',
    tag: 'add · re-encrypt',
    desc: 'A copy is an ADD, but NOT a cheap pointer-copy: content is sealed under the file\'s own fileKey, so the copy CANNOT reference file2\'s encrypted CID — it must DECRYPT file2 and RE-ENCRYPT the plaintext under a fresh cpFile, yielding a new cpCid. No rotation, no re-grant; B & C auto-reach the copy by chaining.',
    before: {
      label: 'before — Folder A.children',
      lines: [
