---
const releases = [
  {
    version: '0.37.0',
    date: '2026-04-06',
    features: ['IPNS signature storage and verification'],
    fixes: [
      'Fix sequence number mismatch in cached IPNS resolves',
      'Align file upload IPNS sequence and verify file pointers',
    ],
  },
  {
    version: '0.36.0',
    date: '2026-04-01',
    features: ['Expose API version on /health endpoint'],
    fixes: ['Replace emoji sidebar icons with consistent inline SVGs'],
  },
  {
    version: '0.35.0',
    date: '2026-03-31',
    features: [
      'Desktop vault settings integration',
      'User-configurable vault parameters',
    ],
    fixes: [],
  },
  {
    version: '0.34.0',
    date: '2026-03-30',
    features: ['Parallel batch upload pipeline with Web Worker encryption'],
    fixes: [],
  },
  {
    version: '0.32.0',
    date: '2026-03-30',
    features: [
      'Code hygiene and structured logging',
      'Infrastructure hardening',
      'Web app observability (Grafana Faro)',
      'AES-256-CTR streaming media encryption',
      'TEE worker migration to Phala Cloud CVM',
    ],
    fixes: [],
  },
];
---

<section class="section" id="releases">
  <h2 class="section-title">Recent Releases</h2>
  <div class="releases-list">
    {releases.map((r) => (
      <div class="release-entry">
        <div class="release-header">
          <span class="release-version">v{r.version}</span>
          <span class="release-date">{r.date}</span>
        </div>
        {r.features.length > 0 && (
          <ul class="release-items">
            {r.features.map((f) => (
              <li class="release-item feature-item">
                <span class="item-prefix">{'+ '}</span>{f}
              </li>
            ))}
          </ul>
        )}
        {r.fixes.length > 0 && (
          <ul class="release-items">
            {r.fixes.map((f) => (
              <li class="release-item fix-item">
                <span class="item-prefix">{'* '}</span>{f}
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
  <a
    href="https://github.com/FSM1/cipher-box/blob/main/CHANGELOG.md"
    class="btn btn-secondary changelog-link"
    target="_blank"
    rel="noopener"
  >
    View Full Changelog
  </a>
</section>

<style>
  .releases-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .release-entry {
    border-left: 2px solid var(--color-green-darker);
    padding-left: var(--spacing-md);
  }

  .release-header {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xs);
  }

  .release-version {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-green-primary);
  }

  .release-date {
    font-size: var(--font-size-xs);
    color: var(--color-text-dim);
  }

  .release-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .release-item {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    display: flex;
    gap: 0;
  }

  .item-prefix {
    min-width: 16px;
    font-weight: var(--font-weight-bold);
  }

  .feature-item .item-prefix {
    color: var(--color-green-primary);
  }

  .fix-item .item-prefix {
    color: var(--color-text-dim);
  }

  .changelog-link {
    margin-top: var(--spacing-md);
  }
</style>
