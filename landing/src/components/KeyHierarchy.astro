---

<section class="section canvas-section" id="key-hierarchy">
  <h2 class="section-title">Key Hierarchy</h2>
  <p class="section-desc">
    Keys are either randomly generated or deterministically derived via HKDF-SHA256.
    Compromising one file key reveals nothing about other files.
  </p>
  <div class="canvas-container">
    <canvas
      id="key-canvas"
      data-animate-canvas
      width="1200"
      height="420"
    ></canvas>
  </div>
</section>

<style>
  .section-desc {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    margin-bottom: var(--spacing-xl);
    max-width: 600px;
  }

  .canvas-container {
    border: 1px solid var(--color-border-dim);
    background: rgb(0 0 0 / 60%);
  }

  #key-canvas {
    width: 100%;
    height: 420px;
  }

  @media (max-width: 768px) {
    #key-canvas {
      height: 380px;
    }
  }
</style>

<script>
  import { initKeyHierarchy } from '../scripts/key-hierarchy';

  const canvas = document.getElementById('key-canvas') as HTMLCanvasElement;
  if (canvas) {
    initKeyHierarchy(canvas);
  }
</script>
