<canvas id="matrix-rain" aria-hidden="true"></canvas>

<style>
  #matrix-rain {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    opacity: 0.12;
    pointer-events: none;
  }
</style>

<script>
  import { initMatrixRain } from '../scripts/matrix-rain';

  const canvas = document.getElementById('matrix-rain') as HTMLCanvasElement;
  if (canvas) {
    initMatrixRain(canvas);
  }
</script>
