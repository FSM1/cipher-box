                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "429": {
            "description": "Per-recipient ack rate limit exceeded"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Ack a message: hard delete by id, scoped to the caller mailbox",
        "tags": [
          "Mailbox"
        ]
      }
    },
    "/registry/register": {
      "post": {
        "operationId": "RegistryController_register",
