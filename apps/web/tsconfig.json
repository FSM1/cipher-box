{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  // Building the reference is what puts `@cipherbox/client`'s declarations on
  // disk, so a typecheck can never read a stale or missing dist.
  "references": [{ "path": "../../packages/client/tsconfig.build.json" }],
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
