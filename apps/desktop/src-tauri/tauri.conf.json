{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CipherBox",
  "identifier": "com.cipherbox.desktop",
  "version": "0.45.2",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBQUQzQTY5RTUwN0EyRgpSV1F2ZWxDZXB0T3FDbC8xK3FLdTJ0UkVHbUhDNFNjWVNWQUdFcENGazNUazY5SkpVNFgrRGNZTgo=",
      "endpoints": ["https://github.com/FSM1/cipher-box/releases/latest/download/latest.json"]
    }
  }
}
