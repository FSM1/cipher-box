{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CipherBox",
  "identifier": "com.cipherbox.desktop",
  "version": "0.45.2",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CipherBox",
        "width": 960,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
