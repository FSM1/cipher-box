<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shell links the user-installed libfuse-t.dylib, which carries a
	     third-party Developer ID. Under the hardened runtime, library
	     validation refuses to load it and the mount never comes up. The
	     accepted cost of the FUSE-T backend: any dylib on the rpath can now
	     load into the process. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
