# Dependencies
node_modules/

# Build output
dist/
target/
# Worktree-local CARGO_TARGET_DIR: a shared target dir silently reuses stale
# test binaries across worktrees, so each one gets its own `target-<name>/`.
target-*/
*.tsbuildinfo

# Environment files
**/.env
**/.env.local
**/.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test coverage
coverage/

# Generated wasm-bindgen glue for the web app's engine worker
apps/web/src/wasm/

# The web e2e suite's release-bundle comparison build
apps/web/dist-release/

# Playwright test results
packages/client/test/browser/pkg/
packages/client/playwright-report/
packages/client/test-results/
tests/web-e2e/playwright-report/
tests/web-e2e/test-results/

# Playwright screenshots
.playwright-mcp/*.png

# UAT screenshots
/tc*.png
/after-*.png

# Load harness metrics reports (uploaded as a dispatch-run artifact)
load-reports/

# Temporary files
temp/*
tests/e2e/test-results/*
.claude/settings.local.json
.claude/gsd-migration-journal/
.worktale/

# GSD local install — machine-specific (absolute paths baked in on local installs).
# Regenerate on a fresh clone with: npx -y --package=@opengsd/gsd-core@1.6.0 -- gsd-core --claude --local
.claude/gsd-core/
.claude/commands/gsd/
.claude/commands/gsd-*
.claude/scripts/
.claude/agents/gsd-*
.claude/hooks/gsd-*
.claude/hooks/lib/gsd-*
.claude/hooks/lib/git-cmd.js
.claude/hooks/managed-hooks-registry.cjs
.claude/package.json
.claude/gsd-file-manifest.json
.claude/gsd-install-state.json
.claude/gsd-pristine/
.claude/gsd-local-patches/
.claude/gsd-user-files-backup/

# GSD planning scratch (docs-generation backups, wave manifests)
.planning/tmp/
