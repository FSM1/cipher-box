{
  // The Node suites read the WASM modules and the core KAT vectors from disk.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"]
  },
  // `opfs.d.ts` is ambient, and the barrel the suite imports reaches the seams.
  "include": ["test/node", "test/production-wasm", "src/seams/opfs.d.ts"]
}
