[
  {
    "title": "IPNS DB Fallback Rate High",
    "ruleGroup": "CipherBox Performance",
    "folderUID": "GRAFANA_ALERTS_FOLDER_UID",
    "noDataState": "OK",
    "execErrState": "OK",
    "for": "5m",
    "condition": "B",
    "annotations": {
      "summary": "IPNS DB fallback rate exceeds 20%",
      "description": "More than 20% of IPNS resolutions are falling back to database cache. Indicates Someguy or DHT health degradation. Check Someguy container, Kubo connectivity."
    },
    "labels": {
      "severity": "warning",
      "service": "cipherbox",
      "operation": "ipns-db-fallback"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "GRAFANA_CLOUD_DATASOURCE_UID",
        "model": {
          "expr": "sum(rate(cipherbox_ipns_resolves_total{source=\"db_cache\"}[10m])) / sum(rate(cipherbox_ipns_resolves_total[10m]))",
          "intervalMs": 15000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": { "type": "gt", "params": [0.2] },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "type": "last" }
            }
          ],
          "refId": "B"
        }
      }
    ]
  }
]
