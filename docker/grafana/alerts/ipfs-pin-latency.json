[
  {
    "title": "IPFS Pin p95 Warning",
    "ruleGroup": "CipherBox Performance",
    "folderUID": "GRAFANA_ALERTS_FOLDER_UID",
    "noDataState": "OK",
    "execErrState": "OK",
    "for": "5m",
    "condition": "B",
    "annotations": {
      "summary": "IPFS pin p95 latency exceeds threshold (>50ms)",
      "description": "IPFS pin latency (p95 over 5m window) has exceeded the baseline threshold. Check Kubo daemon health, pebbleds datastore status, and disk I/O."
    },
    "labels": {
      "severity": "warning",
      "service": "cipherbox",
      "operation": "ipfs-pin"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "GRAFANA_CLOUD_DATASOURCE_UID",
        "model": {
          "expr": "histogram_quantile(0.95, sum(rate(cipherbox_ipfs_ipns_duration_seconds_bucket{operation=\"pin\", result=\"success\"}[5m])) by (le))",
          "intervalMs": 15000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": { "type": "gt", "params": [0.05] },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "type": "last" }
            }
          ],
          "refId": "B"
        }
      }
    ]
  },
