[
  {
    "title": "Accelerator Upstream Down",
    "ruleGroup": "CipherBox Infrastructure",
    "folderUID": "GRAFANA_ALERTS_FOLDER_UID",
    "noDataState": "NoData",
    "execErrState": "Error",
    "for": "5m",
    "condition": "B",
    "annotations": {
      "summary": "A read-accelerator upstream is down: {{ $labels.job }}",
      "description": "The Alloy scrape of kubo or someguy fails for 5 minutes, so the upstream behind the fronted vhost is down or unreachable. Caddy denies on any non-204 forward_auth answer and logs nothing for these two vhosts, so this metric is the only signal. Check the container: docker compose ps ipfs someguy, then docker compose logs."
    },
    "labels": {
      "severity": "critical",
      "service": "cipherbox",
      "operation": "accelerator-upstream"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "GRAFANA_CLOUD_DATASOURCE_UID",
        "model": {
          "expr": "min by (job) (up{job=~\"kubo|someguy\"})",
          "intervalMs": 30000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": { "type": "lt", "params": [1] },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "type": "last" }
            }
          ],
          "refId": "B"
        }
      }
    ]
  }
]
