[
  {
    "title": "Test Login Rate High",
    "ruleGroup": "CipherBox Security",
    "folderUID": "GRAFANA_ALERTS_FOLDER_UID",
    "noDataState": "OK",
    "execErrState": "OK",
    "for": "5m",
    "condition": "B",
    "annotations": {
      "summary": "Test login rate exceeds 100/hour on staging",
      "description": "The POST /auth/test-login endpoint returns success more than 100 times per hour. This may indicate unauthorized access attempts or misconfigured test automation. Verify the TEST_LOGIN_SECRET is not leaked and check request source IPs."
    },
    "labels": {
      "severity": "warning",
      "service": "cipherbox",
      "operation": "test-login"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": { "from": 3600, "to": 0 },
        "datasourceUid": "GRAFANA_CLOUD_DATASOURCE_UID",
        "model": {
          "expr": "sum(increase(auth_attempts_total{route=\"/auth/test-login\", outcome=\"success\"}[1h]))",
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": { "from": 3600, "to": 0 },
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": { "type": "gt", "params": [100] },
              "operator": { "type": "and" },
              "query": { "params": ["B"] },
              "reducer": { "type": "last", "params": [] }
            }
          ],
          "refId": "B"
        }
      }
    ]
  }
]
