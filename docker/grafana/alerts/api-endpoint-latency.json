[
  {
    "title": "API Login p95 Warning",
    "ruleGroup": "CipherBox Performance",
    "folderUID": "GRAFANA_ALERTS_FOLDER_UID",
    "noDataState": "OK",
    "execErrState": "OK",
    "for": "5m",
    "condition": "B",
    "annotations": {
      "summary": "/auth/login p95 latency exceeds threshold (>1s)",
      "description": "Login endpoint p95 latency (5m window) exceeds the baseline threshold. Check database connection pool health and signature verification cost on the 2-vCPU staging box."
    },
    "labels": {
      "severity": "warning",
      "service": "cipherbox",
      "operation": "api-auth-login"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "GRAFANA_CLOUD_DATASOURCE_UID",
        "model": {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{route=\"/auth/login\"}[5m])) by (le))",
          "intervalMs": 15000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": { "type": "gt", "params": [1] },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "type": "last" }
            }
          ],
          "refId": "B"
        }
      }
    ]
  },
