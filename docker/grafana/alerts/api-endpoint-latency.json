[
  {
    "title": "API Upload p95 Warning",
    "ruleGroup": "CipherBox Performance",
    "folderUID": "GRAFANA_ALERTS_FOLDER_UID",
    "noDataState": "OK",
    "execErrState": "OK",
    "for": "5m",
    "condition": "B",
    "annotations": {
      "summary": "POST /ipfs/upload p95 latency exceeds threshold (>100ms)",
      "description": "Upload endpoint p95 latency (5m window) has exceeded the baseline threshold. Check Kubo pin performance, disk I/O, and upload payload sizes."
    },
    "labels": {
      "severity": "warning",
      "service": "cipherbox",
      "operation": "api-upload"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "GRAFANA_CLOUD_DATASOURCE_UID",
        "model": {
          "expr": "histogram_quantile(0.95, sum(rate(cipherbox_http_request_duration_seconds_bucket{method=\"POST\", route=\"/ipfs/upload\", status_code=\"201\"}[5m])) by (le))",
          "intervalMs": 15000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": { "type": "gt", "params": [0.1] },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "type": "last" }
            }
          ],
          "refId": "B"
        }
      }
    ]
  },
