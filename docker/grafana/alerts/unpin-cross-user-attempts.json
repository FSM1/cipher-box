[
  {
    "title": "Unpin Cross-User Attempt Rate",
    "ruleGroup": "CipherBox Security",
    "folderUID": "GRAFANA_ALERTS_FOLDER_UID",
    "noDataState": "OK",
    "execErrState": "OK",
    "for": "5m",
    "condition": "B",
    "annotations": {
      "summary": "Unpin cross-user attempts detected",
      "description": "A non-zero rate of cipherbox_unpin_cross_user_attempts_total means one or more callers are invoking POST /ipfs/unpin with a CID owned by another user. This is the signal of a potential cross-tenant probe against the unpin ownership check. Investigate the source IP and userId patterns in the API logs."
    },
    "labels": {
      "severity": "warning",
      "service": "cipherbox",
      "operation": "unpin-security"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "GRAFANA_CLOUD_DATASOURCE_UID",
        "model": {
          "expr": "rate(cipherbox_unpin_cross_user_attempts_total[5m])",
          "intervalMs": 15000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": { "type": "gt", "params": [0] },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "type": "last" }
            }
          ],
          "refId": "B"
        }
      }
    ]
  }
]
