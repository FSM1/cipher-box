# CipherBox Staging - Caddy Reverse Proxy & Web App
# Cloudflare Origin CA certificates for Full (Strict) SSL mode
# Cloudflare handles browser-facing TLS; Caddy handles CF-to-origin TLS

{
	auto_https off
}

api-staging.cipherbox.cc {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	respond /metrics 403
	reverse_proxy api:3000
}

app-staging.cipherbox.cc {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	root * /srv/web

	# 'wasm-unsafe-eval' is required: Chromium blocks all WebAssembly compilation
	# without it, killing the engine worker and the Core Kit tssLib. Google
	# Identity Services serves the sign-in button's script from its own origin,
	# so 'self' alone would leave that method unable to load. default-src is
	# omitted so login frames and API calls to third-party origins stay
	# unrestricted.
	header {
		Content-Security-Policy "script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
	}

	# Fingerprinted assets must 404 when absent; the SPA fallback would otherwise
	# answer a missing script or wasm module with a 200 text/html index.html.
	handle /assets/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

:80 {
	redir https://{host}{uri} permanent
}
